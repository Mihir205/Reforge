# =============================================================================
# AutoMigrate — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.

# --- LLM Provider ---
# Choose one: local (Ollama), OpenAI, or Anthropic
OLLAMA_MODEL=qwen2.5-coder:7b

# If using a cloud provider instead of local:
# OPENAI_API_KEY=your-openai-api-key-here
# ANTHROPIC_API_KEY=your-anthropic-api-key-here

# --- LangSmith Tracing ---
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your-langsmith-api-key-here
LANGCHAIN_PROJECT=automigrate

# --- RAG / Embeddings ---
# Embedding model for vector store (sentence-transformers)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Reranker model
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Vector store persist directory
CHROMA_PERSIST_DIR=./data/chroma_db

# --- Agent Config ---
MAX_RETRIES=3
CONFIDENCE_AUTO_APPROVE_THRESHOLD=90
CONFIDENCE_QUICK_REVIEW_THRESHOLD=70
